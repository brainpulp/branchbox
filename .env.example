# Branchbox reuses PIM's Supabase project (ikztpvxfgmhmrcwolwgx).
# Copy this file to .env.local and fill in the values
# (Supabase dashboard → Project Settings → API, or MCP get_project_url / get_publishable_keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Reverse-image discovery (Google Lens) runs through the `discover` Supabase
# Edge Function, which holds the SerpAPI key SERVER-SIDE — no client env needed.
# Set/rotate it with:  supabase secrets set SERPAPI_KEY=...  (project ikztpvxfgmhmrcwolwgx)
# Get a free key at https://serpapi.com/manage-api-key
