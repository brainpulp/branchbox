# Branchbox reuses PIM's Supabase project (ikztpvxfgmhmrcwolwgx).
# Copy this file to .env.local and fill in the values
# (Supabase dashboard → Project Settings → API, or MCP get_project_url / get_publishable_keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stock-photo discovery source. Provide ONE of these (free keys):
#   Pexels: https://www.pexels.com/api/   Unsplash: https://unsplash.com/developers
VITE_PEXELS_KEY=
VITE_UNSPLASH_KEY=
